<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="MY_PROJECT.Site1" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="description" content="Ashion - clothing, footwear and accessories">
    <meta name="keywords" content="Ashion, fashion, clothing, shop">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Ashion</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cookie&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,500;0,700;1,500&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Css Styles -->
    <link rel="stylesheet" href="css/bootstrap.min.css" type="text/css">
    <link rel="stylesheet" href="css/font-awesome.min.css" type="text/css">
    <link rel="stylesheet" href="css/elegant-icons.css" type="text/css">
    <link rel="stylesheet" href="css/jquery-ui.min.css" type="text/css">
    <link rel="stylesheet" href="css/magnific-popup.css" type="text/css">
    <link rel="stylesheet" href="css/owl.carousel.min.css" type="text/css">
    <link rel="stylesheet" href="css/slicknav.min.css" type="text/css">
    <link rel="stylesheet" href="css/style.css" type="text/css">

    <!-- Ashion look: overrides for the template header, menu, offcanvas and footer.
         Placed after style.css on purpose so it wins. All template class names
         are untouched, so the template JS (main.js) keeps working. -->
    <style>
        :root {
            --red: #ca1515;
            --red-deep: #8f0c0c;
            --ink: #2a1417;
            --muted: #7d6b6d;
            --paper: #fbf8f7;
            --line: #e4d9d9;
            --display: "Bodoni Moda", "Didot", Georgia, serif;
            --body: "Manrope", "Segoe UI", Arial, sans-serif;
        }

        .header, .footer, .offcanvas-menu-wrapper { font-family: var(--body); }

        /* ---------- Wordmark ---------- */
        .wordmark {
            display: inline-block;
            font-family: var(--display);
            font-weight: 700;
            font-size: 30px;
            letter-spacing: 0.02em;
            line-height: 1;
            color: var(--ink);
            text-decoration: none;
        }

        .wordmark:hover { color: var(--red); text-decoration: none; }

        /* ---------- Header ---------- */
        .header {
            background: var(--paper);
            border-bottom: 1px solid var(--line);
        }

        .header__logo { padding: 26px 0; }

        .header__menu ul li { margin-right: 24px; }
        .header__menu ul li:last-child { margin-right: 0; }

        .header__menu ul li a {
            font-family: var(--body);
            font-size: 14px;
            font-weight: 600;
            text-transform: none;
            letter-spacing: 0;
            color: var(--ink);
            white-space: nowrap;
            transition: color .2s ease;
        }

        .header__menu ul li a:hover,
        .header__menu ul li.active a { color: var(--red); }

        /* underline that draws in on hover and stays on the active page */
        .header__menu ul li a:after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -6px;
            width: auto;
            height: 1.5px;
            background: var(--red);
            opacity: 1;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .25s ease;
        }

        .header__menu ul li a:hover:after,
        .header__menu ul li.active a:after { transform: scaleX(1); }

        .header__right__auth a.header-user {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 700;
            color: var(--ink);
            text-decoration: none;
        }

        .header__right__auth a.header-user:hover { color: var(--red); }
        .header__right__auth a.header-user i { font-size: 24px; color: var(--red); }

        .header__right__widget li span,
        .header__right__widget li a { color: var(--ink); }

        .header__right__widget li a:hover,
        .header__right__widget li span:hover { color: var(--red); }

        .header .tip, .offcanvas__widget .tip {
            background: var(--red);
            color: #fff;
            font-family: var(--body);
            font-weight: 700;
        }

        .canvas__open { color: var(--ink); border-color: var(--line); }

        /* ---------- Offcanvas (mobile menu) ---------- */
        .offcanvas-menu-wrapper { background: var(--paper); }
        .offcanvas__close { color: var(--ink); }
        .offcanvas__widget li a, .offcanvas__widget li span { color: var(--ink); }

        .offcanvas__auth a {
            font-family: var(--body);
            font-weight: 700;
            color: var(--ink);
        }

        .offcanvas__auth a i { color: var(--red); }

        .slicknav_nav a {
            font-family: var(--body);
            font-weight: 600;
            text-transform: none;
            color: var(--ink);
        }

        .slicknav_nav a:hover { background: transparent; color: var(--red); }

        /* ---------- Footer ---------- */
        .footer {
            padding: 0;
            background: var(--paper);
            border-top: 0;
        }

        /* pinstripe strip, same fabric as every page header */
        .footer::before {
            content: "";
            display: block;
            height: 8px;
            background:
                repeating-linear-gradient(90deg, rgba(255,255,255,0.18) 0 1px, transparent 1px 22px),
                linear-gradient(90deg, var(--red), var(--red-deep));
        }

        .footer > .container { padding-top: 56px; }

        .footer__about p {
            max-width: 340px;
            font-size: 14px;
            line-height: 1.7;
            color: var(--muted);
        }

        .footer__widget h6,
        .footer__newslatter h6 {
            font-family: var(--display);
            font-size: 20px;
            font-weight: 700;
            text-transform: none;
            letter-spacing: 0;
            color: var(--ink);
            margin-bottom: 18px;
        }

        .footer__widget ul li a {
            font-size: 14px;
            color: var(--muted);
            transition: color .2s ease;
        }

        .footer__widget ul li a:hover { color: var(--red); }

        .footer__social a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            margin-right: 8px;
            border: 1.5px solid var(--line);
            border-radius: 50%;
            background: transparent;
            color: var(--ink);
            transition: background .2s ease, color .2s ease, border-color .2s ease;
        }

        .footer__social a:hover { background: var(--red); border-color: var(--red); color: #fff; }

        .footer__copyright__text {
            margin-top: 24px;
            padding: 22px 0 28px;
            border-top: 1px solid var(--line);
            text-align: left;
        }

        .footer__copyright__text p { margin: 0; font-size: 13px; color: var(--muted); }

        @media (prefers-reduced-motion: reduce) {
            .header *, .footer * { transition: none !important; }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Offcanvas Menu Begin -->
        <div class="offcanvas-menu-overlay"></div>
        <div class="offcanvas-menu-wrapper">
            <div class="offcanvas__close">+</div>
            <ul class="offcanvas__widget">
                <li><span class="icon_search search-switch"></span></li>
                <li><a href="#"><span class="icon_heart_alt"></span><div class="tip">2</div></a></li>
                <li><a href="#"><span class="icon_bag_alt"></span><div class="tip">2</div></a></li>
            </ul>
            <div class="offcanvas__logo">
                <a href="index.aspx" class="wordmark">Ashion</a>
            </div>
            <div id="mobile-menu-wrap"></div>
            <div class="offcanvas__auth">
                <a id="lnkOffcanvasAuth" runat="server" href="Register.aspx" title="User Account"><i class="fa fa-user-circle"></i> Admin</a>
            </div>
        </div>
        <!-- Offcanvas Menu End -->

        <!-- Header Section Begin -->
        <header class="header">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-xl-2 col-lg-2">
                        <div class="header__logo">
                            <a href="index.aspx" class="wordmark">Ashion</a>
                        </div>
                    </div>
                    <div class="col-xl-7 col-lg-7">
                        <nav class="header__menu">
                            <ul>
                                <li class="active"><a href="index.aspx">Home</a></li>
                                <li><a href="shop.aspx">Shop</a></li>
                                <li><a href="Show_company.aspx">Shop by company</a></li>
                               <%-- <li><a href="Dashboard.aspx">User profile</a></li>--%>
                               <%-- <li><a href="product-details.aspx">Product details</a></li>--%>
                                <li><a href="shop-cart.aspx">Shop cart</a></li>
                                <li><a href="checkout.aspx">Checkout</a></li>

                               <%-- <li><a href="#">Pages</a>
                                    <ul class="dropdown">

                                        <li><a href="Dashboard.aspx">User Profile</a></li>
                                        <li><a href="product-details.aspx">Product Details</a></li>
                                        <li><a href="shop-cart.aspx">Shop Cart</a></li>
                                        <li><a href="checkout.aspx">Checkout</a></li>
                                    </ul>
                                </li>
                               --%> <li><a href="blog.aspx">Blog</a></li>
                                <li><a href="contact.aspx">Contact</a></li>
                            </ul>
                        </nav>
                    </div>
                    <div class="col-lg-3">
                        <div class="header__right">
                            <div class="header__right__auth">
                                <a id="lnkHeaderAuth" runat="server" href="Dashboard.aspx" title="User Account" class="header-user">
                                    <i class="fa fa-user-circle"></i>
                                    <asp:Label ID="lblHeaderUserName" runat="server"></asp:Label>
                                </a>
                            </div>
                            <ul class="header__right__widget">
                                <li><span class="icon_search search-switch"></span></li>
                                <li><a href="#"><span class="icon_heart_alt"></span><div class="tip">2</div></a></li>
                                <li><a href="#"><span class="icon_bag_alt"></span><div class="tip">2</div></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="canvas__open">
                    <i class="fa fa-bars"></i>
                </div>
            </div>
        </header>
        <!-- Header Section End -->

        <!-- Main Body Content Placeholder -->
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <!-- Footer Section Begin -->
        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 col-md-6 col-sm-7">
                        <div class="footer__about">
                            <div class="footer__logo">
                                <a href="index.aspx" class="wordmark">Ashion</a>
                            </div>
                            <p>Clothing, footwear and accessories from the companies you love, all in one place.</p>
                            <div class="footer__payment">
                                <a href="#"><img src="img/payment/payment-1.png" alt=""></a>
                                <a href="#"><img src="img/payment/payment-2.png" alt=""></a>
                                <a href="#"><img src="img/payment/payment-3.png" alt=""></a>
                                <a href="#"><img src="img/payment/payment-4.png" alt=""></a>
                                <a href="#"><img src="img/payment/payment-5.png" alt=""></a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-5">
                        <div class="footer__widget">
                            <h6>Quick links</h6>
                            <ul>
                                <li><a href="#">About</a></li>
                                <li><a href="blog.aspx">Blogs</a></li>
                                <li><a href="contact.aspx">Contact</a></li>
                                <li><a href="#">FAQ</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-4">
                        <div class="footer__widget">
                            <h6>Account</h6>
                            <ul>
                                <li><a href="Dashboard.aspx">My account</a></li>
                                <li><a href="#">Order tracking</a></li>
                                <li><a href="checkout.aspx">Checkout</a></li>
                                <li><a href="#">Wishlist</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-8 col-sm-8">
                        <div class="footer__newslatter">
                            <h6>Follow us</h6>
                            <div class="footer__social">
                                <a href="#"><i class="fa fa-facebook"></i></a>
                                <a href="#"><i class="fa fa-twitter"></i></a>
                                <a href="#"><i class="fa fa-youtube-play"></i></a>
                                <a href="#"><i class="fa fa-instagram"></i></a>
                                <a href="#"><i class="fa fa-pinterest"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="footer__copyright__text">
                            <p>&copy; <script>document.write(new Date().getFullYear());</script> Ashion. All rights reserved.</p>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- Footer Section End -->

        <!-- Js Plugins -->
        <script src="js/jquery-3.3.1.min.js"></script>
        <script src="js/bootstrap.min.js"></script>
        <script src="js/jquery.magnific-popup.min.js"></script>
        <script src="js/jquery-ui.min.js"></script>
        <script src="js/mixitup.min.js"></script>
        <script src="js/jquery.countdown.min.js"></script>
        <script src="js/jquery.slicknav.js"></script>
        <script src="js/owl.carousel.min.js"></script>
        <script src="js/jquery.nicescroll.min.js"></script>
        <script src="js/main.js"></script>
    </form>
</body>
</html>
